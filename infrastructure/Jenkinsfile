pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def changes = sh(script: "git diff --name-only HEAD~1", returnStdout: true).trim()

                    env.BUILD_USER_SERVICE = changes.contains('user-service/') ? 'true' : 'false'
                    env.BUILD_FRONTEND = changes.contains('frontend/') ? 'true' : 'false'

                    echo "Changes detected:\n${changes}"
                    echo "Build user-service: ${env.BUILD_USER_SERVICE}"
                    echo "Build frontend: ${env.BUILD_FRONTEND}"
                }
            }
        }

        stage('Build Services') {
            parallel {
                stage('User Service') {
                    when { expression { env.BUILD_USER_SERVICE == 'true' } }
                    steps {
                        build job: 'user-service', wait: true
                    }
                }

                stage('Frontend') {
                    when { expression { env.BUILD_FRONTEND == 'true' } }
                    steps {
                        build job: 'frontend', wait: true
                    }
                }
            }
        }
    }
}